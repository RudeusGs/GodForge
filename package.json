{
  "name": "godforge",
  "private": true,
  "version": "1.0.0",
  "description": "Specialized Git and project-intelligence platform for Godot Engine development teams.",
  "directories": {
    "doc": "docs"
  },
  "scripts": {
    "test": "node scripts/verify.mjs",
    "verify": "node scripts/verify.mjs",
    "verify:backend": "node scripts/verify.mjs --backend",
    "test:backend:smoke": "node scripts/backend-smoke.mjs",
    "test:workspace:live": "node scripts/workspace-live.mjs",
    "test:m2:provider": "node scripts/m2-provider.mjs",
    "test:m2:acceptance": "node scripts/m2-acceptance.mjs",
    "dev:frontend:docker": "npm run dev:docker --prefix GodForge-FE",
    "docs:check": "node scripts/check-doc-links.mjs",
    "prepare": "husky"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/RudeusGs/GodForge.git"
  },
  "license": "UNLICENSED",
  "type": "commonjs",
  "bugs": {
    "url": "https://github.com/RudeusGs/GodForge/issues"
  },
  "homepage": "https://github.com/RudeusGs/GodForge#readme",
  "devDependencies": {
    "@commitlint/cli": "^19.7.1",
    "@commitlint/config-conventional": "^19.7.1",
    "husky": "^9.1.7",
    "lint-staged": "^15.4.3"
  },
  "lint-staged": {
    "GodForge-BE/**/*.cs": [
      "dotnet format GodForge-BE/GodForge.sln --include"
    ],
    "GodForge-FE/**/*.{vue,js,ts}": [
      "npm run lint --prefix GodForge-FE"
    ]
  }
}
